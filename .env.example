# 赛题通环境变量样例：复制为 .env 后填值，只放占位符，不要提交真实凭据。
# 全部变量都有默认值，留空/删除即走默认；容器里 DATA_DIR 一定要指向可持久化卷。

# --- 服务 ---
PORT=7860
HOST=0.0.0.0

# --- 数据与日志目录（seekdb 索引 + PowerContext SQLite 落在 DATA_DIR，创空间需挂卷） ---
DATA_DIR=./.runtime
DOCS_DIR=./data/docs
LOG_DIR=./logs

# --- 知识库（嵌入式 seekdb） ---
KB_COLLECTION=saitong_kb
KB_MAX_CHUNK_CHARS=1200
KB_TOP_K=5
# auto：探测默认 ONNX 向量模型，拉不到就降级为纯全文检索
# onnx：强制向量化（模型不可用时直接报错，供 Docker 构建期自检）
# fallback：不加载模型，只用全文检索
KB_EMBEDDING=auto

# --- LLM（OpenAI 兼容接口；三项缺任一 → 自动降级为抽取式答案） ---
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=example-model
LLM_TIMEOUT=30

# --- 队伍档案（PowerContext 本地 HTTP 服务） ---
POWERCONTEXT_URL=http://127.0.0.1:8765
# 地址指向回环时应用自己拉起子进程；指向远端则只连接、不再本地启动
POWERCONTEXT_AUTOSTART=1
POWERCONTEXT_DATA_DIR=./.runtime/powercontext
# 可执行文件不在 PATH 时填绝对路径（留空则自动找 powercontext / 当前解释器的 bin 目录）
POWERCONTEXT_BIN=
POWERCONTEXT_READY_TIMEOUT=30

# --- 大赛截止（2026-11-18 24:00 北京时间） ---
DEADLINE=2026-11-19T00:00:00+08:00

# --- 仅 scripts/start.sh 使用 ---
# SKIP_INGEST=0
